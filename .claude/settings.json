{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npx eslint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit -p .)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "mcp__plugin_vercel_vercel__search_vercel_documentation"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checkout-status.sh",
            "timeout": 15,
            "statusMessage": "Checking this folder's branch and changes"
          }
        ]
      }
    ]
  }
}
