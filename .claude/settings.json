{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npx eslint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit -p .)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(npm run worktree:new *)",
      "Bash(npm run dev)",
      "Bash(git merge origin/main)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "mcp__plugin_vercel_vercel__search_vercel_documentation"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checkout-status.sh",
            "timeout": 15,
            "statusMessage": "Checking this folder's branch and changes"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/edit-overlap.sh check",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/edit-overlap.sh record",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
