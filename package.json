{
  "name": "home-finance-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "db:seed:august": "tsx --env-file=.env.local scripts/seed-august.mts",
    "db:backup": "tsx --env-file=.env.local scripts/backup.mts",
    "bills:import": "tsx --env-file=.env.local scripts/import-email.mts",
    "auth:invite": "tsx --env-file=.env.local scripts/invite.mts",
    "storage:setup": "tsx --env-file=.env.local scripts/storage-setup.mts",
    "storage:backup": "tsx --env-file=.env.local scripts/storage-backup.mts",
    "storage:restore": "tsx --env-file=.env.local scripts/storage-restore.mts",
    "worktree:new": "bash scripts/worktree-new.sh",
    "worktrees:clean": "bash scripts/worktrees-clean.sh",
    "branches:clean": "bash scripts/branches-clean.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
