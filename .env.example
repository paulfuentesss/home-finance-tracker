# Copy to .env.local and fill in. Setup: docs/setup.md.

# Database — Supabase: Project → Connect → ORMs → Drizzle.
# Transaction pooler (port 6543) — used by the running app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Session pooler (port 5432) — used by drizzle-kit migrations, scripts and db:backup.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Login — Supabase: Project Settings → API Keys.
# Public by design (every table has RLS with no policies, so these can't read data).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only: creates and deletes invited logins. Never rename it to NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY="sb_secret_..."
