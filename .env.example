# Copy to .env.local and fill in. Setup: docs/setup.md.

# Database — Supabase: Project → Connect → ORMs → Drizzle.
# Session pooler (port 5432) — used by the running app. Not the transaction pooler (6543): it
# hangs on queries sent back to back (docs/decisions.md, 2026-10-11).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Session pooler (port 5432) — used by drizzle-kit migrations, scripts and db:backup.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Login — Supabase: Project Settings → API Keys.
# Public by design (every table has RLS with no policies, so these can't read data).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only: creates and deletes invited logins. Never rename it to NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY="sb_secret_..."
# Server-only: the shared secret the household Gmail's script sends with each bill email
# (app/api/bill-email). Generate with `openssl rand -base64 32`; the same value goes in the
# script's Script Properties. Never rename it to NEXT_PUBLIC_*. Leave empty to turn it off.
BILL_EMAIL_SECRET=""
# Server-only: the key that encrypts the passwords on the Billers tab (lib/biller-secrets.ts).
# Generate with `openssl rand -base64 32`. The SAME value goes in Vercel (localhost and the live
# site share one database), and keep a copy in a password manager: without it, the saved
# passwords can't be read by anyone. Never rename it to NEXT_PUBLIC_*.
BILLER_SECRET_KEY=""

# Emails: reminders and bill emails (docs/operations.md → Emails & reminders). Server-only.
# The My House Gmail, with an app password of its own (not Supabase's).
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
# Localhost only: every email goes here instead of to the housemates (one database!). Empty =
# emails are only logged. Never set it in Vercel — the live site emails the real addresses.
EMAIL_TEST_TO=""
# The daily job's shared secret (app/api/reminders): `openssl rand -base64 32`. Vercel sends it
# by itself; on localhost, any value lets you curl the route. Empty = the route refuses.
CRON_SECRET=""

# Push notifications (docs/operations.md → Push notifications). `npx web-push generate-vapid-keys`.
# The SAME pair here and in Vercel (a device only takes pushes signed with the key it subscribed
# with); keep a copy in a password manager. Empty = push is off, nothing else changes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Server-only (only lib/push.ts reads it). Never rename it to NEXT_PUBLIC_*.
VAPID_PRIVATE_KEY=""
# Localhost only: "on" sends pushes to the admin's own devices as "[test → name]" (one database!).
# Otherwise they're only logged. Never set it in Vercel.
PUSH_TEST=""
